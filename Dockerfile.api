# Stage 1: Build
FROM golang:1.22-alpine AS builder

# Instalar git para descarga de paquetes Go desde VCS
RUN apk add --no-cache git

WORKDIR /app

# Copiar go.mod y código fuente
COPY go.mod ./
COPY . .

# Descargar dependencias y generar go.sum de forma automática
RUN go mod tidy

# Compilar binario de la API
RUN CGO_ENABLED=0 GOOS=linux go build -o /api-server ./cmd/api/main.go

# Stage 2: Runtime Minimal Image
FROM alpine:3.19

RUN apk --no-cache add ca-certificates curl

WORKDIR /root/

COPY --from=builder /api-server .

EXPOSE 8080

CMD ["./api-server"]
