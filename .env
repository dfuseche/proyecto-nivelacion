# Configuración de la API y Worker
PORT=8080
JWT_SECRET=super-secret-okf-jwt-key-2026

# Configuración de la Base de Datos PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=okf_user
DB_PASSWORD=okf_password
DB_NAME=okf_db

# Configuración de la Cola RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=okf_jobs

# Configuración de Almacenamiento de Objetos MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=okf-bundles
MINIO_USE_SSL=false
